# Managed by Ansible — do not edit by hand
# Loopback-only origin for Cloudflare Tunnel. TLS terminates at the Cloudflare edge.
set_real_ip_from 127.0.0.1;
real_ip_header CF-Connecting-IP;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream shell_space_api {
    server {{ network_api_upstream }};
    keepalive 8;
}

server {
    listen {{ network_listen_address }}:{{ network_listen_port }};
    server_name {{ network_domain }};

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    root {{ network_web_root }};
    index index.html;

    location /api/ {
        proxy_pass http://shell_space_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /ws {
        proxy_pass http://shell_space_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    location / {
        try_files $uri /index.html; # SPA routing
    }
}
